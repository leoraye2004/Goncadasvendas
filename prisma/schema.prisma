// ============================================================
// Gonca das Vendas — E-commerce (loja própria, single-seller)
// Prisma schema (PostgreSQL)
// Multi-vendedor fica pra fase 2 — schema já organizado pra
// facilitar essa evolução depois (Product isolado de User/Order).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductCondition {
  NEW
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  OUT_OF_STOCK
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum PaymentProvider {
  MERCADO_PAGO
  STRIPE
  PIX_MANUAL
}

enum AIInsightType {
  STOCK_ALERT
  PRICE_SUGGESTION
  SALES_REPORT
  PRODUCT_DESCRIPTION // reservado p/ fase 2 (foto -> anúncio)
}

enum AIInsightStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER_UPDATE
  STOCK_ALERT
  PRICE_SUGGESTION
  SALES_REPORT
  SYSTEM
}

// ------------------------------------------------------------
// USUÁRIOS
// ------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]

  @@index([role])
}

// ------------------------------------------------------------
// CATÁLOGO
// ------------------------------------------------------------

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  icon     String?
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products Product[]

  @@index([parentId])
}

model Product {
  id                     String            @id @default(cuid())
  categoryId             String
  category               Category          @relation(fields: [categoryId], references: [id])

  name                   String
  slug                   String            @unique
  description            String
  brand                  String?
  condition              ProductCondition  @default(NEW)

  costPrice              Decimal?          @db.Decimal(10, 2) // usado p/ IA de precificação
  basePrice              Decimal           @db.Decimal(10, 2) // preço "a partir de"

  status                 ProductStatus     @default(DRAFT)
  aiGeneratedDescription Boolean           @default(false)
  viewCount              Int               @default(0)

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  images                 ProductImage[]
  variants               ProductVariant[]
  reviews                Review[]
  orderItems             OrderItem[]

  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}

// Variante cobre: capacidade/cor de iPhone, ml de perfume, tamanho de roupa etc.
// "attributes" guarda o que for específico da categoria (ex: {"storage":"256GB","color":"Azul"})
model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String          @unique
  attributes     Json
  price          Decimal         @db.Decimal(10, 2)
  stock          Int             @default(0)
  imageUrl       String?

  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  variantId String
  variant   ProductVariant    @relation(fields: [variantId], references: [id])
  type      StockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime          @default(now())

  @@index([variantId])
  @@index([createdAt])
}

// ------------------------------------------------------------
// CARRINHO
// ------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)

  @@unique([cartId, variantId])
}

// ------------------------------------------------------------
// ENDEREÇO
// ------------------------------------------------------------

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  label        String? // "Casa", "Trabalho"
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String
  isDefault    Boolean @default(false)

  orders       Order[]

  @@index([userId])
}

// ------------------------------------------------------------
// PEDIDOS / PAGAMENTOS
// ------------------------------------------------------------

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  addressId     String?
  address       Address?    @relation(fields: [addressId], references: [id])

  status        OrderStatus @default(PENDING_PAYMENT)
  subtotal      Decimal     @db.Decimal(10, 2)
  shippingFee   Decimal     @default(0) @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items         OrderItem[]
  payments      Payment[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product        @relation(fields: [productId], references: [id])
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id])

  productNameSnapshot String
  quantity            Int
  unitPrice           Decimal        @db.Decimal(10, 2)
  subtotal            Decimal        @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id])
  provider          PaymentProvider
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(10, 2)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([orderId])
}

// ------------------------------------------------------------
// AVALIAÇÕES
// ------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@unique([productId, userId])
}

// ------------------------------------------------------------
// CUPONS
// ------------------------------------------------------------

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int          @default(0)
  createdAt     DateTime     @default(now())
}

// ------------------------------------------------------------
// IA — AUTOMAÇÃO DO ADMIN (núcleo do MVP)
// ------------------------------------------------------------

// Registro único de "insight" gerado pela IA, seja de estoque, preço ou relatório.
model AIInsight {
  id        String          @id @default(cuid())
  type      AIInsightType
  payload   Json            // dados estruturados (produto, projeção, preço sugerido, texto do relatório etc.)
  status    AIInsightStatus @default(PENDING)
  createdAt DateTime        @default(now())

  @@index([type])
  @@index([status])
}

// ------------------------------------------------------------
// NOTIFICAÇÕES
// ------------------------------------------------------------

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([read])
}
