# Copie para .env e ajuste. Em produção estes valores vêm dos segredos do Container App (Terraform).

# Banco (obrigatório). Local: docker run -d --name gv-postgres -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL="postgresql://postgres:dev@localhost:5432/postgres?schema=public"

# NextAuth (obrigatórios)
NEXTAUTH_SECRET="troque-por-uma-string-longa-e-aleatoria"
NEXTAUTH_URL="http://localhost:3000"

# Opcionais
# APPLICATIONINSIGHTS_CONNECTION_STRING=""   # liga o monitoramento no Application Insights
# AZURE_STORAGE_CONNECTION_STRING=""         # upload das imagens dos produtos (Azure Blob)
# SEED_ADMIN_PASSWORD=""                     # senhas do `npm run seed`; sem elas, o seed gera aleatórias
# SEED_CUSTOMER_PASSWORD=""
